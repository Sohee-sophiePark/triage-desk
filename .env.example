# Triage Desk — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── Application ──
APP_NAME=triage-desk
APP_ENV=development  # development | staging | production
DEBUG=true
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ── Database ──
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./triage_desk.db
# Production (PostgreSQL via Neon)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>
# Docker Compose (required by docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── LLM (Gemini free tier via LiteLLM) ──
# live = real calls · record = live + save to cassette · replay = cassette only (no key)
LLM_MODE=live
GEMINI_API_KEY=
# Optional: free-tier models only, newest first (default chain 3.8 Flash → 2.5 Flash-Lite in backend/app/agents/config.py)
# MODELS=["gemini/gemini-3.8-flash","gemini/gemini-3.5-flash-lite","gemini/gemini-2.5-flash"]

# ── Auth ──
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis (optional, falls back to in-memory) ──
# REDIS_URL=redis://localhost:6379/0
# Production (Upstash):
# REDIS_URL=rediss://default:<token>@<host>:6379

# ── ChromaDB ──
CHROMA_PERSIST_DIRECTORY=./chroma_data

# ── CORS ──
# Development origins are set automatically. Only set ALLOWED_ORIGINS in production.
# Comma-separated list: ALLOWED_ORIGINS=https://app.yourdomain.com
ALLOWED_ORIGINS=

# ── Dev seed users (data/seed_users.py, development only) — one login per role, all required ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_FRAUD_EMAIL=
SEED_FRAUD_PASSWORD=
SEED_RISK_EMAIL=
SEED_RISK_PASSWORD=
SEED_COMPLIANCE_EMAIL=
SEED_COMPLIANCE_PASSWORD=

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=60

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json  # json | text
